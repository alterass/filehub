{
  "name": "filehub",
  "version": "0.1.0",
  "description": "LAN-first personal cloud storage: WebUI, Node.js + TypeScript + Hono + PGlite + Drizzle",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "node scripts/build-webui.mjs && tsc -p tsconfig.json && node scripts/build-launchers.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/build-webui.mjs && tsx watch src/server/main.ts",
    "preserve": "npm run build",
    "serve": "node dist/server/cli.js",
    "prestart": "npm run build",
    "start": "node dist/server/cli.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@hono/node-server": "^1.13.0",
    "@napi-rs/canvas": "^1.0.11",
    "drizzle-orm": "^0.36.0",
    "ffmpeg-static": "^5.3.0",
    "hono": "^4.6.0",
    "xgplayer": "^3.0.20"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "dompurify": "^3.4.17",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "marked": "^18.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
